APP_CLIENT_HOST=0.0.0.0
APP_CLIENT_PORT=5173

APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=3001

# Endereço que o navegador usa para alcançar o servidor de sinalização.
# Para uso local, localhost. Para outro dispositivo na mesma rede, informe o IP LAN do PC.
APP_PUBLIC_SERVER_PROTOCOL=http
APP_PUBLIC_SERVER_HOST=localhost

# Origem do cliente permitida pelo servidor. Inclua o IP do cliente se usar acesso pela rede local.
APP_CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para produção, deixe vazio: o app usará a origem pública onde está hospedado.
VITE_SIGNAL_URL=

# TURN é opcional. Configure quando STUN não atravessar o NAT da rede.
# VITE_TURN_URL=turn:turn.seudominio.com:3478
# VITE_TURN_USERNAME=usuario
# VITE_TURN_CREDENTIAL=senha
