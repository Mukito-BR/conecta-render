# A configuração local fica no arquivo .env da raiz do projeto.
# Para produção com serviços separados, VITE_SIGNAL_URL deve conter a URL pública do servidor.
# TURN é necessário quando STUN/P2P não atravessar o NAT. Use credenciais do seu provedor.
# VITE_TURN_URL=turn:turn.seudominio.com:3478
# VITE_TURN_USERNAME=usuario
# VITE_TURN_CREDENTIAL=senha
